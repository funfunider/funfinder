REACT_APP_GOOGLE_MAPS_API_KEY=
REACT_APP_API_BASE_URL=https://funfinder-xi.vercel.app/en
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=funfinder
PORT=5000
JWT_SECRET=your_jwt_secret_key

# Bank of Georgia (BOG) Payment Settings
BOG_BASE_URL=https://api.bog.ge
BOG_AUTH_URL=https://oauth2.bog.ge/auth/realms/bog/protocol/openid-connect/token
# BOG Payment Gateway
REACT_APP_BOG_MERCHANT_ID=
REACT_APP_BOG_PUBLIC_KEY=
REACT_APP_BOG_SECRET_KEY=

# Google Pay (Bank of Georgia "georgiancard" gateway)
REACT_APP_GOOGLE_PAY_ENV=PRODUCTION
REACT_APP_GOOGLE_PAY_MERCHANT_ID=
REACT_APP_GOOGLE_PAY_MERCHANT_NAME=Funfinder
REACT_APP_GOOGLE_PAY_GATEWAY=georgiancard
REACT_APP_GOOGLE_PAY_GATEWAY_MERCHANT_ID=
REACT_APP_GOOGLE_PAY_CONFIG_URL=http://localhost:5000/api/v5/payment/bog/google-pay/config
REACT_APP_GOOGLE_PAY_PROCESS_URL=http://localhost:5000/api/v5/payment/bog/google-pay/initiate


# Apple Pay (Bank of Georgia external integration)
REACT_APP_APPLE_PAY_MERCHANT_ID=merchant.com.funfinder.ge
REACT_APP_APPLE_PAY_DISPLAY_NAME=Funfinder
REACT_APP_APPLE_PAY_DOMAIN=funfinder.ge
REACT_APP_APPLE_PAY_COUNTRY=GE
REACT_APP_APPLE_PAY_CURRENCY=GEL
REACT_APP_APPLE_PAY_VALIDATE_URL=http://localhost:5000/api/v5/payment/apple-pay/validate-merchant
REACT_APP_APPLE_PAY_PROCESS_URL=http://localhost:5000/api/v5/payment/apple-pay/process


# Google Auth Backend
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret


# Email Configuration (Nodemailer / Gmail)
SMTP_SERVICE=gmail
SMTP_USER=funfinder.georgia@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="FunFinder Georgia" <funfinder.georgia@gmail.com>
FUNFINDER_ADMIN_EMAIL=funfinder.georgia@gmail.com
FUNFINDER_ADMIN_EMAILS=info@funfinder.ge,i.diasamidze@funfinder.ge
FUNFINDER_VENDOR_NOTIFICATION_EMAIL=
SITE_URL=https://funfinder.ge
